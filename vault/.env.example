# Скопируй этот файл в .env и заполни.

# Адрес сайта, как его видят игроки (без косой черты в конце). Попадает в оповещения и QR-коды.
BASE_URL=https://example.ru
PORT=3000

# Пароль от админки /admin. Без него админка выключена.
ADMIN_PASSWORD=

# Telegram-бот: токен от @BotFather и имя бота без @.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# Если с сервера не открывается api.telegram.org, сюда можно вписать адрес своего прокси к нему.
TG_API_BASE=

# Бот ВКонтакте: ключ доступа сообщества, числовой id сообщества и его короткое имя из адреса vk.com/ИМЯ.
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_GROUP_SCREEN=

# Тестовый вход без ботов. Только для проверки на своём компьютере, на боевом сервере оставить 0.
DEV_LOGIN=0
